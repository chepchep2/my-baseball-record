# Postgres (docker-compose.yml)
DB_PORT=5432
POSTGRES_DB=my_baseball_record
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring local profile datasource
DB_URL=jdbc:postgresql://localhost:5432/my_baseball_record
DB_USERNAME=postgres
DB_PASSWORD=postgres
FLYWAY_ENABLED=true

# Auth settings (for upcoming auth APIs)
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback
KAKAO_FRONTEND_REDIRECT_URI=http://localhost:3000/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
